# OpenAI
OPENAI_API_KEY=

# Speech: macos (built-in `say`) or openai (OpenAI TTS)
SPEECH_ENGINE=macos

# Audio player for OpenAI TTS: auto (macOS: afplay, Linux: mpg123, Android: termux-media-player)
AUDIO_PLAYER=auto

# Optional: prepare audio early and wait until this local time before playback (HH:mm)
# SPEECH_PLAY_AT=08:30

# Weather location (Tokyo Station as an example)
WEATHER_LOCATION_NAME=東京
WEATHER_LATITUDE=35.6812
WEATHER_LONGITUDE=139.7671
TIME_ZONE=Asia/Tokyo

# Google Calendar OAuth files. Do not commit either file.
GOOGLE_CALENDAR_ID=primary
GOOGLE_CREDENTIALS_PATH=.secrets/google-credentials.json
GOOGLE_TOKEN_PATH=.secrets/google-token.json

# エラーメール通知（送信者のGoogleアカウントで pnpm auth:mail を実行）
ERROR_REPORT_EMAIL_ENABLED=false
ERROR_REPORT_EMAIL_FROM=Your Name <your-account@gmail.com>
ERROR_REPORT_EMAIL_TO=Your Name+Ohayo-bot <your-account+ohayo-bot@gmail.com>
ERROR_REPORT_EMAIL_REPLY_TO=Your Name <your-account@gmail.com>
ERROR_REPORT_GOOGLE_CREDENTIALS_PATH=.secrets/google-oauth-client.json
ERROR_REPORT_GOOGLE_TOKEN_PATH=.secrets/google-mail-token.json
